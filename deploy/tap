#!/usr/bin/env python3
"""Pull a verified TAPCamVerifier build and publish it on this host (Python 3.9+)."""

import argparse
import contextlib
import fcntl
import hashlib
import json
import os
from pathlib import Path, PurePosixPath
import re
import shutil
import stat
import sys
import tempfile
import urllib.error
import urllib.parse
import urllib.request
import uuid
import zipfile

REPO = "TAP-NAP/TAPCamVerifier"
WORKFLOW = ".github/workflows/deploy-pages.yml"
API = "https://api.github.com"
MAX_ZIP = 128 * 1024 * 1024
MAX_FILES = 10000
MAX_EXPANDED = 512 * 1024 * 1024
RELEASE_NAME = r"[0-9a-f]{40}-[1-9][0-9]*-[1-9][0-9]*-[1-9][0-9]*"
METADATA = ".tap-release.json"


class Failure(Exception):
    pass


def say(message):
    color = sys.stdout.isatty() and "NO_COLOR" not in os.environ
    print(("\033[36m[tap]\033[0m " if color else "[tap] ") + message, flush=True)


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def request(url, token=""):
    parsed = urllib.parse.urlsplit(url)
    if parsed.scheme != "https" or not parsed.hostname or parsed.username or parsed.password:
        raise Failure("Download redirect must use HTTPS without embedded credentials.")
    headers = {"User-Agent": "tapnap-host-deploy"}
    if token:
        if parsed.netloc != "api.github.com":
            raise Failure("Refusing to send GitHub credentials to another host.")
        headers.update({"Authorization": "Bearer " + token,
                        "Accept": "application/vnd.github+json",
                        "X-GitHub-Api-Version": "2022-11-28"})
    return urllib.request.build_opener(NoRedirect()).open(
        urllib.request.Request(url, headers=headers), timeout=30)


def api(path, token):
    with request(API + "/repos/" + REPO + path, token) as response:
        data = response.read(4 * 1024 * 1024 + 1)
    if len(data) > 4 * 1024 * 1024:
        raise Failure("GitHub API response is too large.")
    return json.loads(data)


def check_run(run):
    if (run.get("status") != "completed" or run.get("conclusion") != "success"
            or run.get("head_branch") != "main"
            or run.get("event") not in ("push", "workflow_dispatch")
            or run.get("path", "").split("@", 1)[0] != WORKFLOW
            or run.get("repository", {}).get("full_name") != REPO
            or run.get("head_repository", {}).get("full_name") != REPO
            or not re.fullmatch(r"[0-9a-f]{40}", run.get("head_sha", ""))
            or not isinstance(run.get("id"), int) or run["id"] <= 0
            or not isinstance(run.get("run_attempt"), int) or run["run_attempt"] <= 0):
        raise Failure("Run must be a successful main-branch push/manual run of " + WORKFLOW)


def select_build(run_id, token):
    if run_id:
        run = api("/actions/runs/" + str(run_id), token)
    else:
        runs = api("/actions/workflows/deploy-pages.yml/runs?branch=main&status=success&per_page=1", token)
        if not runs.get("workflow_runs"):
            raise Failure("No successful main-branch workflow run found.")
        run = runs["workflow_runs"][0]
    check_run(run)
    name = "tapnap-web-" + run["head_sha"] + "-" + str(run["run_attempt"])
    found = api("/actions/runs/" + str(run["id"]) + "/artifacts?per_page=100&name=" + name, token)
    artifacts = [item for item in found.get("artifacts", []) if item.get("name") == name]
    if len(artifacts) != 1:
        raise Failure("Expected one " + name + " artifact. Run the updated workflow first.")
    artifact = artifacts[0]
    origin = artifact.get("workflow_run", {})
    repository_id = run["repository"].get("id")
    if (artifact.get("expired") is not False
            or not re.fullmatch(r"sha256:[0-9a-f]{64}", artifact.get("digest") or "")
            or not isinstance(artifact.get("id"), int) or artifact["id"] <= 0
            or not isinstance(artifact.get("size_in_bytes"), int)
            or not 0 < artifact["size_in_bytes"] <= MAX_ZIP
            or not repository_id
            or origin.get("id") != run["id"] or origin.get("head_sha") != run["head_sha"]
            or origin.get("head_branch") != "main"
            or origin.get("repository_id") != repository_id
            or origin.get("head_repository_id") != repository_id):
        raise Failure("Artifact is expired, oversized, lacks a SHA-256 digest, or has the wrong origin.")
    return {"commit": run["head_sha"], "run_id": run["id"], "attempt": run["run_attempt"],
            "artifact_id": artifact["id"], "digest": artifact["digest"]}


def download(build, target, token):
    url = API + "/repos/" + REPO + "/actions/artifacts/" + str(build["artifact_id"]) + "/zip"
    # GitHub authenticates the API request, then redirects to a short-lived storage URL.
    # Never forward the token to storage, including on subsequent redirects.
    for hop in range(6):
        try:
            response = request(url, token if hop == 0 else "")
            break
        except urllib.error.HTTPError as error:
            if error.code not in (301, 302, 303, 307, 308) or not error.headers.get("Location"):
                raise
            url = urllib.parse.urljoin(url, error.headers["Location"])
            error.close()
    else:
        raise Failure("Too many artifact download redirects.")
    digest = hashlib.sha256()
    count = 0
    with response, target.open("xb") as output:
        while True:
            chunk = response.read(1024 * 1024)
            if not chunk:
                break
            count += len(chunk)
            if count > MAX_ZIP:
                raise Failure("Artifact download exceeded 128 MiB.")
            output.write(chunk)
            digest.update(chunk)
    if "sha256:" + digest.hexdigest() != build["digest"]:
        raise Failure("Artifact SHA-256 does not match GitHub metadata.")
    say("Downloaded and verified " + str(count) + " bytes.")


def unpack(archive, destination):
    destination.mkdir()
    with zipfile.ZipFile(archive) as bundle:
        entries = bundle.infolist()
        if len(entries) > MAX_FILES or sum(item.file_size for item in entries) > MAX_EXPANDED:
            raise Failure("Artifact exceeds the extraction size/file limit.")
        seen = set()
        total = 0
        for item in entries:
            name = item.filename.rstrip("/")
            path = PurePosixPath(name)
            kind = stat.S_IFMT(item.external_attr >> 16)
            if (not name or name != str(path) or path.is_absolute()
                    or any(part in (".", "..") for part in path.parts)
                    or any(part.startswith(".") for part in path.parts) and name != ".nojekyll"
                    or "\\" in name or any(ord(char) < 32 for char in name)
                    or name in seen or kind not in (0, stat.S_IFREG, stat.S_IFDIR)
                    or kind == stat.S_IFDIR and not item.is_dir()
                    or item.flag_bits & 1
                    or item.compress_type not in (zipfile.ZIP_STORED, zipfile.ZIP_DEFLATED)):
                raise Failure("Artifact contains an unsafe or duplicate entry.")
            seen.add(name)
            target = destination.joinpath(*path.parts)
            if item.is_dir():
                target.mkdir(parents=True, exist_ok=True)
                continue
            target.parent.mkdir(parents=True, exist_ok=True)
            with bundle.open(item) as source, target.open("xb") as output:
                while True:
                    chunk = source.read(1024 * 1024)
                    if not chunk:
                        break
                    total += len(chunk)
                    if total > MAX_EXPANDED:
                        raise Failure("Expanded artifact exceeded 512 MiB.")
                    output.write(chunk)
            target.chmod(0o644)
    for directory in [destination, *(item for item in destination.rglob("*") if item.is_dir())]:
        directory.chmod(0o755)
    for page in ("index.html", "verify/index.html", "privacy/index.html"):
        if not (destination / page).is_file() or (destination / page).stat().st_size == 0:
            raise Failure("Artifact is missing " + page)
    if not any((destination / "assets").glob("tapcam_verifier_wasm-*.wasm")):
        raise Failure("Artifact must contain the versioned verifier WASM. Run the updated build.")


def file_digest(path):
    digest = hashlib.sha256()
    with path.open("rb") as source:
        for chunk in iter(lambda: source.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.digest()


def current_target(root, link="current"):
    path = root / link
    if not path.is_symlink():
        if path.exists():
            raise Failure(str(path) + " must be a managed symlink; existing files were left intact.")
        return None
    target = os.readlink(path)
    if (not re.fullmatch("releases/" + RELEASE_NAME, target)
            or (root / "releases").is_symlink() or (root / target).is_symlink()
            or not (root / target).is_dir()):
        raise Failure("Invalid or missing " + link + " release.")
    return target


def replace_link(root, name, target):
    temporary = root / ("." + name + "-" + uuid.uuid4().hex)
    try:
        temporary.symlink_to(target)
        os.replace(temporary, root / name)
    finally:
        temporary.unlink(missing_ok=True)


@contextlib.contextmanager
def locked(root):
    new_root = not root.exists()
    root.mkdir(parents=True, exist_ok=True)
    if new_root:
        root.chmod(0o755)
    with (root / ".deploy.lock").open("a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise Failure("Another update or rollback is running.") from None
        yield


def publish(root, site, build):
    old = current_target(root)
    previous = current_target(root, "previous")
    name = "{commit}-{run_id}-{attempt}-{artifact_id}".format(**build)
    target = "releases/" + name
    release = root / target
    for directory in (root / "releases", root / "shared", root / "shared/assets"):
        if directory.is_symlink():
            raise Failure("Deployment directories must not be symlinks.")
        directory.mkdir(exist_ok=True)
        directory.chmod(0o755)
    if release.is_symlink():
        raise Failure("Release directories must not be symlinks.")
    if release.exists():
        if json.loads((release / METADATA).read_text()) != build:
            raise Failure("Existing release metadata does not match the downloaded artifact.")
    else:
        (site / METADATA).write_text(json.dumps(build, indent=2) + "\n")
        # Keep old hashed URLs reachable for open tabs and rollback. Hard links avoid
        # duplicate asset storage; a collision must never overwrite a live resource.
        for source in sorted((site / "assets").rglob("*")):
            if not source.is_file():
                continue
            destination = root / "shared/assets" / source.relative_to(site / "assets")
            parent = root / "shared/assets"
            for part in source.relative_to(site / "assets").parts[:-1]:
                parent /= part
                if parent.is_symlink():
                    raise Failure("Asset directories must not be symlinks.")
                parent.mkdir(exist_ok=True)
                parent.chmod(0o755)
            if destination.exists() or destination.is_symlink():
                if destination.is_symlink() or not destination.is_file() or file_digest(destination) != file_digest(source):
                    raise Failure("An existing asset has different bytes: " + destination.name)
                source.unlink()
                os.link(destination, source)
            else:
                os.link(source, destination)
        os.rename(site, release)
    if old == target:
        return
    if old:
        replace_link(root, "previous", old)
    # Final commit point: all validation, resource writes and metadata precede this.
    try:
        replace_link(root, "current", target)
    except OSError:
        if previous:
            replace_link(root, "previous", previous)
        elif old:
            (root / "previous").unlink()
        raise


def update(root, run_id, token, dry_run):
    build = select_build(run_id, token)
    say("Candidate: " + build["commit"] + " | run " + str(build["run_id"]) + " | attempt " + str(build["attempt"]))
    with contextlib.nullcontext() if dry_run else locked(root):
        with tempfile.TemporaryDirectory(prefix=".tap-download-", dir=None if dry_run else root) as staging:
            staging = Path(staging)
            download(build, staging / "artifact.zip", token)
            unpack(staging / "artifact.zip", staging / "site")
            run = api("/actions/runs/" + str(build["run_id"]), token)
            check_run(run)
            if run["head_sha"] != build["commit"] or run["run_attempt"] != build["attempt"]:
                raise Failure("The workflow was rerun during download; retry the update.")
            if dry_run:
                say("Check passed. Download and extraction work; no website was changed.")
            else:
                publish(root, staging / "site", build)
                say("Published " + build["commit"] + ". Nginx must use the supplied web locations.")


def rollback(root):
    with locked(root):
        old = current_target(root)
        previous = current_target(root, "previous")
        if not old or not previous:
            raise Failure("Both current and previous releases are required for rollback.")
        replace_link(root, "current", previous)
        say("Rolled back to " + previous.removeprefix("releases/"))


def status(root):
    for link in ("current", "previous"):
        target = current_target(root, link)
        if target:
            build = json.loads((root / target / METADATA).read_text())
            say(link + ": " + build["commit"] + " | run " + str(build["run_id"]) + " | artifact " + str(build["artifact_id"]))
        else:
            say(link + ": not installed")
    say("Web root: " + str(root))
    if root.exists():
        say("Free disk: {:.1f} GiB".format(shutil.disk_usage(root).free / 1024 ** 3))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=("update", "status", "rollback"))
    parser.add_argument("service", choices=("web",))
    parser.add_argument("--root", type=Path, default=Path("/var/www/tapnap"), help="website storage directory")
    parser.add_argument("--run", type=int, help="successful GitHub run ID; default: latest successful main run")
    parser.add_argument("--dry-run", action="store_true", help="download and verify without changing the website")
    args = parser.parse_args()
    if (args.run is not None and args.run <= 0) or (args.command != "update" and (args.run or args.dry_run)):
        parser.error("--run and --dry-run apply only to update; run IDs must be positive")
    root = args.root.expanduser().resolve()
    try:
        if args.command == "update":
            token = os.environ.get("GH_TOKEN") or os.environ.get("GITHUB_TOKEN")
            if not token:
                raise Failure("Set GH_TOKEN to a GitHub token with Actions: read for " + REPO + ".")
            update(root, args.run, token, args.dry_run)
        elif args.command == "rollback":
            rollback(root)
        else:
            status(root)
    except urllib.error.HTTPError as error:
        say("FAILED: GitHub/download HTTP " + str(error.code) + ". Check token permissions, artifact expiry and network access.")
        return 1
    except urllib.error.URLError:
        say("FAILED: HTTPS connection failed. Check ECS access to GitHub API and artifact storage.")
        return 1
    except (Failure, OSError, ValueError, KeyError, zipfile.BadZipFile) as error:
        say("FAILED: " + str(error))
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
