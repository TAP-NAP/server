# Direct local Rust development. Host Docker deployment uses tap config instead.
# Bind the development server to loopback.
SERVER_ADDR=127.0.0.1:8080
# Local Redis address.
REDIS_URL=redis://127.0.0.1:6379
# Apple identifiers must match the App that creates the attestation.
TEAM_ID=YOUR_APPLE_TEAM_ID
BUNDLE_ID=com.example.tapcam
# production for release; development for the current Debug App.
APP_ATTEST_ENV=production
# Local file for cargo run; Docker carries its own copy at /app/certs/...
APPLE_APP_ATTEST_ROOT_CA_PATH=certs/apple_app_attestation_root_ca.pem
# Challenge lifetime in seconds.
CHALLENGE_TTL_SECONDS=3600
# Enable per-request business logs only when needed.
REQUEST_LOGS=false
# Rust tracing filter and output colors (always/never/auto).
RUST_LOG=tap_app_attest_server=info,tower_http=warn
LOG_COLOR=always
